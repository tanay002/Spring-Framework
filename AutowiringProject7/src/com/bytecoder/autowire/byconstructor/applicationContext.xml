<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans  
                http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
           
           <bean id="comp" class="com.bytecoder.autowire.byconstructor.Company" autowire="constructor">
       <!--    <constructor-arg ref="product2"></constructor-arg> -->
            </bean>
            
            <bean id="product2" class="com.bytecoder.autowire.byconstructor.Product">
            <property name="productCode" value="5152"></property>
            <property name="productName" value="Desktop Application"></property>
            </bean>
            
            <bean id="product1" class="com.bytecoder.autowire.byconstructor.Product">
            <property name="productCode" value="5156"></property>
            <property name="productName" value="Web Application"></property>
            </bean>
            
            <bean id="product3" class="com.bytecoder.autowire.byconstructor.Product" primary="true">
            <property name="productCode" value="5757"></property>
            <property name="productName" value="Enterprise Applications"></property>
            </bean>
</beans>