<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
	<bean id="emp" class="com.bytecoder.core.setud.Employee">
		<property name="eid" value="102"></property>
		<property name="ename" value="Tanay"></property>
		<property name="mobno">
		<set>
		<ref bean="mob1"/>
		<ref bean="mob2"/>
		<ref bean="mob3"/>
		<ref bean="mob4"/>
		</set>
		</property>
	</bean>
	
	<bean id="mob1" class="com.bytecoder.core.setud.Mobileno">
	<property name="mobno" value="9907820661"></property>
	<property name="countrycode" value="91"></property>
	</bean>
	
	<bean id="mob2" class="com.bytecoder.core.setud.Mobileno">     
	<property name="mobno" value="8878056735"></property>
	<property name="countrycode" value="91"></property>
	</bean>
	<bean id="mob3" class="com.bytecoder.core.setud.Mobileno">
	<property name="mobno" value="8319991976"></property>
	<property name="countrycode" value="91"></property>
	</bean>
	
	<bean id="mob4" class="com.bytecoder.core.setud.Mobileno">
	<property name="mobno" value="9907820661"></property>       <!-- set ki  property follow hona chaiye ..duplicate data nhi anna chaiye -->
	<property name="countrycode" value="91"></property>       <!--so we have to override hashcode and equals method  -->
	</bean>
</beans>