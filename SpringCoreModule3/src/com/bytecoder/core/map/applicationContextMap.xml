<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
	<bean id="cmp" class="com.bytecoder.core.map.Company">
		<property name="cid" value="1725"></property>
		<property name="cname" value="MI"></property>
		<property name="pname">
			<map>
				<entry key="1001" value="MI TV"></entry>
				<entry key="1002" value="MI Phones"></entry>
				<entry key="1003" value="MI Bags"></entry>
				<entry key="1004" value="MI Cables"></entry>
				<entry key="1004" value="MI Earphones"></entry> <!-- map does not contain duplicate key but it may contain duplicate values -->
			</map>                                    <!--we does not need to override hashcode and equals method for premitive datatype  -->
		</property>                                      <!-- if the key is same then it will replace the new value   -->
	</bean>
</beans>