<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
	<bean id="tra" class="coremodule.setterinjection8.Map.Trainer">
		<property name="tid" value="4152"></property>
		<property name="tname" value="Tanay Saxena"></property>
		<property name="data">
			<map>
				<entry key-ref="cour1" value="exp1"></entry>
			</map>
		</property>
	</bean>
	<bean id="exp1" class="coremodule.setterinjection8.Map.Experience">
		<property name="totalExp" value="2"></property>
		<property name="compName" value="TCS"></property>
	</bean>

	<bean id="cour1" class="coremodule.setterinjection8.Map.Course">
		<property name="courses" value="Corporate Java"></property>
		<property name="code" value="5617"></property>
	</bean>
</beans>