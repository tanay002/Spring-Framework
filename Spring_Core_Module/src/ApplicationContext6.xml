<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
               <bean id="intern" class="coremodule.setterinjection6.Set.Internship">
               <property name="cname" value="TCS"></property>
               <property name="course" value="Corporate Java"></property>
               <property name="stud">
               <set>
               <ref bean="student1"/>
               <ref bean="student2"/>
               </set>
               </property>
               </bean>
               <bean id="student1" class="coremodule.setterinjection6.Set.Student">
               <property name="sname" value="Tanay sir"></property>
               <property name="enrollid" value="7656"></property> 
               </bean>
               
               <bean id="student2" class="coremodule.setterinjection6.Set.Student">
               <property name="sname" value="Rahul Dev"></property>
               <property name="enrollid" value="7236"></property> 
               </bean>
               </beans>