<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
	
	<bean id="emp" class="com.bytecoder.constructor.coreud.Employee">
		<constructor-arg value="201" type="int"></constructor-arg>
		<constructor-arg value="Tanay" type="String"></constructor-arg>
		<constructor-arg ref="cmp"></constructor-arg>
	</bean>
	
	<bean id="cmp" class="com.bytecoder.constructor.coreud.Company">
	<constructor-arg value="TCS" type="String"></constructor-arg>
	</bean>
</beans>