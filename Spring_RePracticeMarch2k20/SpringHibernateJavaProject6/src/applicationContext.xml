<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans  
                http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource">  <!-- Class BasicDataSource  -->
	<property name="driverClassName" value="com.mysql.jdbc.Driver"></property>
	<property name="url" value="jdbc:mysql://localhost:3306/onlinesession"></property>
	<property name="username" value="root"></property>
	<property name="password" value="root"></property>
	</bean>
	
	
	
	                        <!--Class  LocalSessionFactoryBean have "has a realtionship"-->
                          <!-- datamembers 1.) BasicDataSource dataSource; 2.) hibernateProperties;3.)List mappingResources -->   
      
      <bean id="mySessionFactory" class="org.springframework.orm.hibernate4.LocalSessionFactoryBean">
      <property name="dataSource" ref="dataSource"></property>
      <!-- <property name="mappingResources"> -->
      <property name="annotatedClasses">
      <list>
      <!-- <value>UserDto.hbm.xml</value> -->
      <value>com.bytecoder.UserDto</value>
      </list>
      </property>
      
      <property name="hibernateProperties">
      <props>
      <prop key="hibernate.dialect">org.hibernate.dialect.MySQLDialect</prop>
      <prop key="hibernate.hbm2ddl.auto">update</prop>
      <prop key="hibernate.show_sql">true</prop>
      </props>
      </property>
      </bean>
      
                                    <!--Class  HibernateTemplate have "has a realtionship" with class LocalSessionFactoryBean-->
                                       <!-- datamembers 1.) LocalSessionFactoryBean sessionFactory-->   
                                       
        <bean id="template" class="org.springframework.orm.hibernate4.HibernateTemplate">
        <property name="sessionFactory" ref="mySessionFactory"></property>
        </bean>
      </beans>                                      